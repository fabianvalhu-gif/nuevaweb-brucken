{
  "rewrites": [
    { "source": "/contacto", "destination": "/index.html" },
    { "source": "/admin(.*)", "destination": "/index.html" },
    { "source": "/insights", "destination": "/index.html" },
    { "source": "/insights/(.*)", "destination": "/index.html" },
    { "source": "/industrias/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
